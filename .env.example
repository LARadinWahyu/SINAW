# ==== SINAU — contoh konfigurasi environment ====
# Salin menjadi .env.local (lokal) atau isi di Vercel → Project → Settings → Environment Variables.
# Semua variabel bersifat OPSIONAL. Tanpa variabel ini, website berjalan dalam MODE DEMO
# (data tersimpan di browser masing-masing pengguna).

# --- Supabase (rencana integrasi backend: auth, database, RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI NARA (server only — JANGAN diberi prefix NEXT_PUBLIC_) ---
# Kosongkan = NARA memakai jawaban demo (bukan model AI).
NARA_AI_API_KEY=
NARA_AI_MODEL=
